# --- Nest ---
NODE_ENV=development          # development | production | test (validat în EnvironmentVariables)
PORT=5000                     # portul pe care ascultă Nest

# --- Postgres (le citește containerul la PRIMA pornire, cu volum gol) ---
POSTGRES_USER=slice           # userul creat la init
POSTGRES_PASSWORD=change-me   # valoare falsă intenționat; fiecare își pune parola în .env
POSTGRES_DB=slice             # baza de date creată la init

# --- Unde găsește Nest baza de date ---
POSTGRES_HOST=localhost       # Nest rulează pe host, Postgres e expus pe localhost
POSTGRES_PORT=5432            # partea STÂNGĂ din ports: în compose

# URL-ul complet, compus din cele de mai sus (necesită expandVariables: true)
DATABASE_URL="postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}"
